{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@adapters/*": ["./src/adapters/*"],
      "@application/*": ["./src/application/*"],
      "@config/*": ["./src/config/*"],
      "@domain/*": ["./src/domain/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "tests", "vitest.config.ts"]
}
